# Copie para .env.local e informe a chave antes do build.

# Adicione seu token da api open api aqui
NASA_API_KEY=sua-chave

# Astronomy Picture of the Day (APOD)
NASA_API_URL=https://science.nasa.gov/wp-json/wp/v2/apod-basic

# InSight Mars Weather
NASA_INSIGHT_WEATHER_URL=https://api.nasa.gov/insight_weather/

# Near Earth Object Web Service (Asteroids)
NASA_NEOWS_URL=https://api.nasa.gov/neo/rest/v1
